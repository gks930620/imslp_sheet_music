# ============================================
# 환경변수 템플릿 — 이 파일을 복사해 .env 로 만들고 실제 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore/.dockerignore 로 제외되어 VCS/이미지에 포함되지 않는다.
# ⚠️ 실제 시크릿을 이 .env.example 에 채우지 말 것 (이 파일은 커밋 대상).
# ============================================

# --- OAuth2 (Kakao) ---
KAKAO_CLIENT_ID=
# 카카오 개발자 콘솔에서 "Client Secret > 활성화"한 경우에만 값 필요. 미사용이면 빈 값 허용.
KAKAO_CLIENT_SECRET=

# --- OAuth2 (Google) ---
GOOGLE_CLIENT_ID=
# 구글은 인가코드→access_token 교환에 secret이 필요하다. 절대 커밋 금지.
GOOGLE_CLIENT_SECRET=

# --- JWT 서명키 ---
# 길이만 충분하고(권장 64 hex 이상) 외부에 노출되지 않으면 됨. 배포마다 새로 생성 권장.
JWT_SECRET_KEY=

# ============================================
# 운영 환경(Railway) 추가 설정
#  - 로컬(dev)은 H2 인메모리라 아래 DB 값이 필요 없다.
#  - 운영은 Railway MySQL 사용. 아래 값들은 보통 Railway 대시보드의
#    "서비스 Variables"에 등록한다(.env 로 배포하지 않음). 여긴 참고용 목록.
# ============================================

# 데이터베이스 (Railway MySQL) — prod 프로파일 필수(기본값 없음: 미설정 시 기동 실패/fail-fast)
#   Railway Reference Variables 로 조립 예시:
# SPRING_DATASOURCE_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}
# SPRING_DATASOURCE_USERNAME=${{MySQL.MYSQLUSER}}
# SPRING_DATASOURCE_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# 앱 기본 URL (운영) — OAuth redirect-uri, WebSocket 허용 출처에 사용
# APP_BASE_URL=https://your-app.up.railway.app

# 파일 저장: Railway Storage Buckets(S3 호환) 사용 (§5-3).
#   운영(prod)에서 아래 BUCKET_* 미설정 시 RailwayDeploymentValidator 가 기동 실패(fail-fast).
#   로컬(dev)은 BUCKET_ENDPOINT 를 비워두면 LocalFileStorage(디스크)로 자동 폴백된다.
#   Railway Reference Variables 예시(버킷 서비스명이 <프로젝트>_bucket 일 때):
# BUCKET_ENDPOINT=${{<프로젝트>_bucket.BUCKET_ENDPOINT}}
# BUCKET_ACCESS_KEY_ID=${{<프로젝트>_bucket.BUCKET_ACCESS_KEY_ID}}
# BUCKET_SECRET_ACCESS_KEY=${{<프로젝트>_bucket.BUCKET_SECRET_ACCESS_KEY}}
# BUCKET_NAME=${{<프로젝트>_bucket.BUCKET_NAME}}
# BUCKET_REGION=us-east-1
